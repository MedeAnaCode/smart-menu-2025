FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# The browser reaches Keycloak directly during the IP-only trial deployment.
ARG SMARTMENU_KEYCLOAK_PORT=8080
ENV SMARTMENU_KEYCLOAK_PORT=$SMARTMENU_KEYCLOAK_PORT
RUN npm run build

FROM nginx:1.27-alpine

COPY infra/nginx/server.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
# Webpack emits JavaScript bundles to dist, while images, fonts and the
# Keycloak silent SSO callback are served directly from public in development.
COPY --from=build /app/public /usr/share/nginx/html

EXPOSE 80
