# Copy this file on the server as .env.server, then replace every value below.
# This file is deliberately safe to commit; .env.server itself is ignored.

# IP-only testing: do not add a trailing slash.
APP_ORIGIN=http://45.10.217.72
KEYCLOAK_PUBLIC_URL=http://45.10.217.72:8080
APP_PORT=80
KEYCLOAK_PORT=8080

POSTGRES_DB=smartmenu
POSTGRES_USER=smartmenu
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-password

# Leave these empty to disable AI recipe import until it is explicitly set up.
AI_RECIPE_PROVIDER=yandex
YANDEX_AI_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_AI_RECIPE_MODEL=yandexgpt-lite
