KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-local-password

# Yandex AI Studio recipe import. Do not put the secret in client-side variables.
AI_RECIPE_PROVIDER=yandex
YANDEX_AI_API_KEY=replace-with-yandex-ai-studio-api-key
YANDEX_FOLDER_ID=replace-with-yandex-cloud-folder-id
YANDEX_AI_RECIPE_MODEL=yandexgpt-lite
